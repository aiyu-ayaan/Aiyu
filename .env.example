# ─────────────────────────────────────────────────────────────────────────
# PostgreSQL (Prisma) Configuration
# ─────────────────────────────────────────────────────────────────────────
# Prisma reads DATABASE_URL. The four POSTGRES_* vars below are consumed by
# the Docker Compose Postgres service to provision the database/user, and are
# interpolated into DATABASE_URL.
#
#   - Local host dev (Next.js + Prisma run on your machine, Postgres in Docker
#     via docker-compose-dev.yml): use host "localhost".
#   - Inside Docker Compose (docker-compose.yml / docker-compose-local.yml):
#     use the service hostname "postgres".
#
# Local host dev example:
#   DATABASE_URL=postgresql://aiyu:CHANGE_THIS_PASSWORD@localhost:5432/aiyu?schema=public
# In-container example (Compose):
#   DATABASE_URL=postgresql://aiyu:CHANGE_THIS_PASSWORD@postgres:5432/aiyu?schema=public

DATABASE_URL=postgresql://aiyu:CHANGE_THIS_PASSWORD@localhost:5432/aiyu?schema=public

# Credentials used by the Postgres container (docker-compose*.yml) to create
# the role and database on first boot. Keep them in sync with DATABASE_URL.
POSTGRES_USER=aiyu
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=aiyu
# Host port the Postgres container is published on (defaults to 5432).
POSTGRES_PORT=5432

# Optional: pgAdmin login (docker-compose-dev.yml only).
PGADMIN_DEFAULT_EMAIL=admin@aiyu.org
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_PASSWORD
PGADMIN_PORT=5050

# N8N Webhook URL
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_MINIMUM_12_CHARS

# GitHub OAuth admin login (optional, single-user).
# When GITHUB_AUTH_ENABLED=true the /admin/login page shows ONLY "Continue with
# GitHub" and the username/password path is disabled. Set it to false (or leave
# unset) to instantly revert to the password form above — no redeploy logic.
# Access is locked to ONE account by immutable numeric GitHub id: anyone can
# complete the OAuth flow, but only GITHUB_ALLOWED_ID is admitted. Find your id
# at https://api.github.com/users/<your-username> (the "id" field).
# Register a GitHub OAuth App; its callback URL must EXACTLY match what this app
# sends (scheme + host + port + path). By default the app derives it from
# SITE_URL/NEXT_PUBLIC_BASE_URL. A GitHub OAuth App allows only ONE callback URL,
# so set GITHUB_OAUTH_CALLBACK_URL to override it per environment (e.g. localhost
# in dev) without changing SITE_URL — or use a separate OAuth App per env.
GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_ID=                                    # numeric id, e.g. 76834976 — NOT the username
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# JWT Secret
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING

# Local direct app port for docker-compose-local.yml (optional, defaults to 3000)
APP_PORT=3000

# Production nginx HTTP port for docker-compose.yml (optional, defaults to 80)
NGINX_HTTP_PORT=80

# Production nginx HTTPS port for docker-compose.yml (optional, defaults to 443)
NGINX_HTTPS_PORT=443

# The app container runs WITHOUT memory/CPU caps so it can use the full server.
# Do NOT set NODE_OPTIONS=--max-old-space-size here: a low heap cap OOMs the
# container at runtime and `next build --webpack` inherits it and dies (exit 134).

# SEO Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SITE_URL=
NEXT_PUBLIC_AUTHOR_NAME=Your Name Here

# Security reminders
# 1. Never commit the actual .env file to git
# 2. Rotate secrets regularly
# 3. Use different secrets for each environment
