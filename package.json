{
  "name": "aiyu",
  "version": "4.7.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:all": "vitest run && playwright test",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:up": "docker compose -f docker-compose-dev.yml up -d",
    "db:down": "docker compose -f docker-compose-dev.yml down",
    "migrate:mongo": "node --env-file=.env scripts/migrate-mongodb-to-postgres.mjs",
    "perf:k6:public": "k6 run scripts/k6/public-routes.js",
    "security-check": "node scripts/security-check.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "docker:build": "docker-compose build --no-cache",
    "docker:up": "docker-compose up -d",
    "docker:up:dev": "docker compose --env-file .env.production -f docker-compose-local.yml up -d --build",
    "docker:up:prod": "docker compose --env-file .env.production -f docker-compose.yml up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:verify": "bash scripts/verify-security.sh",
    "emergency:cleanup": "bash scripts/emergency-cleanup.sh",
    "screenshots:install": "npx playwright install chromium",
    "screenshots:capture": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
