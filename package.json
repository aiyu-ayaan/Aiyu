    "lucide-react": "^1.18.0",
    "next": "^16.2.6",
    "node-fetch": "^3.3.2",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-confetti": "^6.4.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-syntax-highlighter": "^16.1.1",
    "react-vertical-timeline-component": "^4.0.0",
    "remark-gfm": "^4.0.1",
