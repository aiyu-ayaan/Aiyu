    "@google/generative-ai": "^0.24.1",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.19",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "date-fns-tz": "^3.2.0",
    "eventemitter3": "^5.0.4",
    "form-data": "^4.0.5",
    "formdata-node": "^6.0.3",
    "framer-motion": "^12.35.0",
    "gsap": "^3.15.0",
