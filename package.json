{
  "name": "aiyu",
  "version": "6.0.4",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:all": "vitest run && playwright test",
    "build": "pnpm run web:build && pnpm run server:build",
    "start": "server/target/release/aiyu-server",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:up": "docker compose -f docker-compose.dev.local.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.local.yml down",
    "migrate:mongo": "node --env-file=.env scripts/migrate-mongodb-to-postgres.mjs",
    "perf:k6:public": "k6 run scripts/k6/public-routes.js",
    "security-check": "node scripts/security-check.mjs",
    "docker:build": "docker-compose build --no-cache",
    "docker:up": "docker-compose up -d",
    "docker:up:dev": "docker compose --env-file .env.production -f docker-compose.local.yml up -d --build",
    "docker:up:prod": "docker compose --env-file .env.production -f docker-compose.yml up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:verify": "bash scripts/verify-security.sh",
    "emergency:cleanup": "bash scripts/emergency-cleanup.sh",
    "screenshots:install": "pnpm exec playwright install chromium",
    "screenshots:capture": "node scripts/capture-screenshots.mjs",
    "record": "node scripts/record-story.mjs",
    "record:desktop": "node scripts/record-story.mjs --device desktop",
    "record:mobile": "node scripts/record-story.mjs --device mobile",
    "hf:sync": "node scripts/sync-hyperframes.mjs",
    "hf:check": "cd hyperframes/story && pnpm dlx hyperframes@0.8.78 check && cd ../boot && pnpm dlx hyperframes@0.8.78 check",
    "server:build": "cargo build --release --manifest-path server/Cargo.toml",
    "server:test": "cargo test --manifest-path server/Cargo.toml",
    "web:build": "vite build --config web/vite.config.mts",
    "web:typecheck": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hyperframes/player": "^0.8.78",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.20",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "heic-convert": "^2.1.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.25.0",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.6",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "simple-icons": "^16.25.0",
    "three": "^0.185.1",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.51.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.4.2"
}
