{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "node",
    "changelog-path": "CHANGELOG.md",
    "version-file": "package.json",
    "packages": {
        ".": {
            "changelog-path": "CHANGELOG.md",
            "version-file": "package.json",
            "changelog-sections": [
                {
                    "type": "feat",
                    "section": "Features",
                    "hidden": false
                },
                {
                    "type": "fix",
                    "section": "Bug Fixes",
                    "hidden": false
                }
            ],
            "version-bump-behavior": "standard"
        }
    },
    "plugins": [
        {
            "type": "commit-analyzer",
            "config": {
                "releaseRules": [
                    {
                        "breaking": true,
                        "release": "major"
                    },
                    {
                        "type": "feat",
                        "breaking": true,
                        "release": "minor"
                    },
                    {
                        "type": "fix",
                        "breaking": true,
                        "release": "patch"
                    }
                ],
                "parserOpts": {
                    "noteKeywords": ["BREAKING CHANGE", "BREAKING-CHANGE"]
                }
            }
        }
    ]
}