{
    "release-type": "node",
    "changelog-path": "CHANGELOG.md",
    "version-file": "package.json",
    "packages": {
        ".": {
            "changelog-path": "CHANGELOG.md",
            "version-file": "package.json",
            "changelog-sections": [
                {
                    "type": "feat",
                    "scope": null,
                    "section": "Features",
                    "hidden": false
                },
                {
                    "type": "fix",
                    "scope": null,
                    "section": "Bug Fixes",
                    "hidden": false
                }
            ],
            "version-bump-behavior": "standard"
        }
    },
    "commit-types": [
        {
            "type": "feat",
            "breaking": true,
            "release": "minor"
        },
        {
            "type": "fix",
            "breaking": true,
            "release": "patch"
        }
    ]
}