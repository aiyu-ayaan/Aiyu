// Prisma schema for Aiyu — migrated from MongoDB/Mongoose to PostgreSQL.
//
// Design (see docs/MIGRATION_REPORT.md):
//   * Relational models  -> queried/filtered/sorted collections get real
//     columns + indexes mirroring the former Mongoose indexes.
//   * Json-blob models    -> deeply-nested singleton "config document"
//     collections are stored as a single `data Json` column to preserve their
//     exact shapes (strict:false, Maps, nested subdocs) with zero contract drift.
//   * IDs are strings (cuid) so the old `_id` string contract is preserved by
//     the serializer shim (lib/serialize.js maps id -> _id). Migration/import
//     keep the original Mongo `_id`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Relational ───────────────────────────────

model Blog {
  id                String   @id @default(cuid())
  title             String
  slug              String   @default("")
  content           String
  image             String?
  imageAlt          String   @default("")
  excerpt           String   @default("")
  seoTitle          String   @default("")
  seoDescription    String   @default("")
  canonicalUrl      String   @default("")
  keywords          String[] @default([])
  socialTitle       String   @default("")
  socialDescription String   @default("")
  socialImage       String   @default("")
  socialImageAlt    String   @default("")
  noIndex           Boolean  @default(false)
  tags              String[] @default([])
  date              String
  published         Boolean  @default(false)
  isAutomated       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  // Full-text search vector. Declared so Prisma owns the column (no drift);
  // it is populated by a trigger and indexed with GIN via the raw-SQL portion
  // of the init migration. Prisma Client never reads it (queried via $queryRaw).
  searchVector Unsupported("tsvector")?

  // NOTE: case-insensitive title uniqueness + the full-text search trigger/GIN
  // index are added by the companion raw-SQL migration (see migrations).
  @@index([published, createdAt])
  @@index([createdAt])
  @@index([slug])
  @@index([updatedAt])
}

model Project {
  id           String   @id @default(cuid())
  name         String
  slug         String   @default("")
  techStack    String[] @default([])
  year         String
  status       String
  projectType  String
  description  String
  codeLink     String?
  blogLink     String?
  image        String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([displayOrder, year])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([slug])
}

model Deployment {
  id              String   @id @default(cuid())
  name            String
  slug            String   @default("")
  techStack       String[] @default([])
  status          String   @default("Live")
  appType         String
  environment     String   @default("Production")
  hostingProvider String
  description     String
  hostedUrl       String?
  blogLink        String?
  image           String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([displayOrder, updatedAt])
  @@index([createdAt])
  @@index([slug])
}

model Gallery {
  id          String   @id @default(cuid())
  src         String
  thumbnail   String?
  description String
  width       Int
  height      Int
  isPinned    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([isPinned, order, createdAt])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read, createdAt])
  @@index([email])
}

model AiLog {
  id           String   @id @default(cuid())
  provider     String
  model        String
  mode         String
  prompt       String?
  response     String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([provider, createdAt])
}

model Cron {
  id                  String    @id @default(cuid())
  name                String
  type                String    @default("user")
  schedule            String    @default("0 0 * * *")
  enabled             Boolean   @default(true)
  action              String
  webhookUrl          String?
  webhookUrlType      String    @default("fixed")
  webhookMethod       String    @default("POST")
  webhookHeaders      Json      @default("[]")
  webhookHeadersType  String    @default("fixed")
  webhookBody         String?
  webhookBodyType     String    @default("fixed")
  webhookEnv          Json      @default("[]")
  lastRun             DateTime?
  lastRunStatus       String?
  lastRunLog          String?
  nextRun             DateTime?
  notificationEnabled Boolean   @default(false)
  notificationOn      String    @default("always")
  retryEnabled        Boolean   @default(false)
  retryType           String    @default("stable")
  retryCount          Int       @default(3)
  retryDelay          Int       @default(60)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  logs CronLog[]
}

model CronLog {
  id         String   @id @default(cuid())
  cronId     String
  cron       Cron     @relation(fields: [cronId], references: [id], onDelete: Cascade)
  cronName   String
  action     String
  status     String
  method     String?
  url        String?
  log        String
  durationMs Int      @default(0)
  ranAt      DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([cronId, ranAt])
  @@index([status])
  @@index([ranAt])
}

// ──────────────────────────── Observability ────────────────────────────
// Admin security + server-health subsystem. All relational so they ride
// through export/import like every other table.

// DB-backed admin sessions. The login JWT carries a `jti` that maps to one of
// these rows; `getSession()` rejects the token if the row is missing, revoked,
// or expired — which is what makes per-device remote logout possible (a
// stateless JWT alone cannot be individually revoked).
model Session {
  id         String    @id @default(cuid())
  jti        String    @unique
  label      String    @default("")
  ipAddress  String    @default("")
  userAgent  String    @default("")
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([revokedAt, expiresAt])
  @@index([createdAt])
}

// Append-only audit trail of critical admin actions (logins, revokes,
// destructive mutations). Read-only from the dashboard.
model AuditLog {
  id        String   @id @default(cuid())
  action    String // LOGIN_SUCCESS | LOGIN_FAILED | LOGOUT | SESSION_REVOKED | DB_EXPORT | DB_IMPORT | ...
  category  String   @default("system") // auth | content | system | security
  details   String   @default("")
  ipAddress String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([category, createdAt])
}

// Custom endpoints to monitor in the Uptime Pinger, in addition to the
// hostedUrl of every Deployment.
model UptimeTarget {
  id        String   @id @default(cuid())
  label     String
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([enabled, createdAt])
}

// History of uptime pings (written on-demand from the dashboard and by the
// scheduled `uptime_check` system cron).
model UptimeCheck {
  id         String   @id @default(cuid())
  target     String
  label      String   @default("")
  source     String   @default("deployment") // deployment | custom
  status     String // up | down
  statusCode Int      @default(0)
  latencyMs  Int      @default(0)
  error      String   @default("")
  checkedAt  DateTime @default(now())

  @@index([target, checkedAt])
  @@index([checkedAt])
}

// ──────────────────────────── Analytics ────────────────────────────
// Self-hosted, first-party analytics. `AnalyticsEvent` is the raw append-only
// log; `AnalyticsDaily` is a pre-aggregated rollup upserted on each event so
// the dashboard reads O(days) instead of scanning the full event log. Both are
// plain relational models so they ride through export/import like every table.

model AnalyticsEvent {
  id           String   @id @default(cuid())
  type         String // pageview | entity_view | contact_submit | outbound_click
  path         String   @default("")
  entityType   String? // blog | project | app | gallery
  entityId     String?
  entitySlug   String?
  referrer     String   @default("") // normalized host only, no query/PII
  referrerType String   @default("direct") // direct | internal | search | social | external
  device       String   @default("desktop") // mobile | tablet | desktop | bot
  country      String? // from edge/proxy header when available
  visitorHash  String   @default("") // salted SHA-256(IP+UA+day) — rotates daily
  sessionId    String   @default("")
  isBot        Boolean  @default(false)
  meta         Json?    @default("{}") // small extra context (e.g. click target)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@index([referrerType, createdAt])
}

model AnalyticsDaily {
  id         String   @id @default(cuid())
  day        String // YYYY-MM-DD (UTC) bucket
  type       String
  entityType String   @default("")
  entityId   String   @default("")
  views      Int      @default(0)
  uniques    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([day, type, entityType, entityId])
  @@index([day])
  @@index([type, day])
}

model Social {
  id       String  @id @default(cuid())
  name     String
  url      String
  iconName String
  isHidden Boolean @default(false)

  @@index([isHidden])
}

model Theme {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @default("")
  isCustom     Boolean  @default(true)
  isPredefined Boolean  @default(false)
  variants     Json
  previewImage String   @default("")
  author       String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([isCustom, createdAt])
}

// ──────────────────────────── Json-blob singletons ────────────────────────────
// Stored as `data Json` to preserve the exact nested document shape. Secret
// fields that were `select:false` in Mongoose are pulled into dedicated columns
// so the serializer can withhold them by default (see lib/serialize.js).

model Config {
  id                        String   @id @default(cuid())
  data                      Json     @default("{}")
  encryptedGithubToken      String?
  encryptedGeminiApiKey     String?
  encryptedGroqApiKey       String?
  encryptedOpenRouterApiKey String?
  blogApiTokenHash          String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt
}

model Ads {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// SEO & Crawl dashboard config. Json-blob singleton like `Config`/`GitHub`:
// `data` holds robots rules, sitemap overrides, and indexing settings. The
// Google service-account JSON is a secret, stored encrypted in a dedicated
// column withheld by the serializer (see lib/serialize.js CONFIG-style secrets).
model SeoConfig {
  id                            String   @id @default(cuid())
  data                          Json     @default("{}")
  encryptedGoogleServiceAccount String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @default(now()) @updatedAt
}

// Audit trail of Google Indexing API pings. Relational so it rides through
// export/import and stays out of the SeoConfig blob.
model IndexingLog {
  id        String   @id @default(cuid())
  url       String
  type      String // URL_UPDATED | URL_DELETED
  status    String // success | error
  response  String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model About {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Home {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Header {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model NotificationConfig {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model GitHub {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CronEnv {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// MCP server config. Json-blob singleton like `Config`/`SeoConfig`: `data` holds
// the full Model Context Protocol server-card definition (server info, transports,
// advertised capabilities, tools, resources, prompts, and links) that the admin
// panel edits and `/.well-known/mcp/server-card.json` serves. Falls back to
// DEFAULT_MCP_CONFIG when the row is missing (see lib/mcpConfig.js).
model McpConfig {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  // Bearer token that authorizes MCP write tools at /api/mcp. Stored as a
  // SHA-256 hash (withheld by the serializer, like Config.blogApiTokenHash);
  // last4 + updatedAt are non-secret display metadata.
  mcpTokenHash      String?
  mcpTokenLast4     String    @default("")
  mcpTokenUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Schema-driven config for the public AI Hub (/ai). Json-blob singleton like
// `About`/`Home`: `data` holds a `sections` array where each entry is a
// self-describing block ({ id, type, enabled, order, title, ... , data }).
// This is now the page *skeleton* only — section order, shells, and the
// hero/stats payloads. The item content for the four curated sections
// (skills, recommendations, credits, prompts) lives in the relational tables
// below and is hydrated into the section `data` at read time (lib/aiSections).
model AiPage {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ───────────────────────── AI Hub section content ─────────────────────────
// Relational, first-class content for the /ai sections so each is independently
// CRUD-able over REST (/api/ai/*) and MCP, and shareable on its own. `id`s are
// cuid strings (mapped to `_id` by lib/serialize). `displayOrder` drives render
// order within a section, mirroring Project/Deployment.

// A filter category on the Skills section (e.g. "Motion & Animation").
model AiSkillCategory {
  id           String    @id @default(cuid())
  label        String
  accent       String    @default("var(--accent-cyan)")
  displayOrder Int       @default(0)
  skills       AiSkill[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([displayOrder])
}

// A single skill under a category ({ name, description, url? }).
model AiSkill {
  id           String          @id @default(cuid())
  categoryId   String
  category     AiSkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String          @default("")
  url          String?
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  @@index([categoryId, displayOrder])
}

// A recommended-stack card ("the stack I recommend").
model AiRecommendation {
  id           String   @id @default(cuid())
  name         String
  url          String   @default("")
  rating       Int      @default(5)
  accent       String   @default("var(--accent-cyan)")
  blurb        String   @default("")
  tags         String[] @default([])
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([displayOrder])
}

// A free-credits / free-tier ledger row.
model AiCredit {
  id           String   @id @default(cuid())
  name         String
  offer        String   @default("")
  url          String   @default("")
  noCard       Boolean  @default(true)
  freeApi      Boolean  @default(true)
  note         String   @default("")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([displayOrder])
}

// A reusable system prompt in the prompt library.
model AiPrompt {
  id           String   @id @default(cuid())
  title        String
  role         String   @default("")
  prompt       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([displayOrder])
}
